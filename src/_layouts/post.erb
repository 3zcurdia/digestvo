---
layout: default
---

<%
  tags = Array(data.tags)
  sources = [
    ["Hacker News discussion", data.hn_url, :hn],
    ["Lobsters discussion", data.lobsters_url, :lobsters],
  ].reject { |_, url, _| url.nil? || url.to_s.empty? }
%>

<article class="max-w-prose">
  <h1><%= data.title %></h1>

  <% if tags.any? || sources.any? %>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <% tags.each do |tag| %>
        <span
          class="rounded border border-border-color px-2 py-0.5 text-xs text-muted-color"
        >
          <%= tag %>
        </span>
      <% end %>

      <% sources.each do |label, url, kind| %>
        <a
          class="inline-flex items-center text-xs text-action-color hover:opacity-80"
          href="<%= url %>"
          aria-label="<%= label %>"
          title="<%= label %>"
        >
          <% if kind == :hn %>
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.952 17.176c-1.204.34-1.787.533-2.657.533-1.16 0-1.98-.227-2.535-.682-.556-.454-.833-1.2-.833-2.237v-4.394h-1.87v-1.87h1.87V5.785c0-1.04.27-1.857.81-2.452.54-.595 1.32-.892 2.34-.892.9 0 1.67.14 2.31.42v1.86c-.31-.16-.65-.24-1.01-.24-.45 0-.8.14-1.04.42-.24.28-.36.67-.36 1.17v3.09h2.37l-.31 1.87h-2.06v4.39c0 .99.25 1.72.74 2.19.5.47 1.2.7 2.11.7.85 0 1.57-.17 2.17-.51l.03 1.88z"
              />
            </svg>
          <% else %>
            <span aria-hidden="true">🦞</span>
          <% end %>
        </a>
      <% end %>
    </div>
  <% end %>

  <% if data.summary %>
    <p class="mt-5 text-lg text-body-color"><%= data.summary %></p>
  <% end %>

  <% if data.source_url %>
    <p class="mt-5 text-sm">
      <a href="<%= data.source_url %>">Read the original &rarr;</a>
    </p>
  <% end %>

  <%= yield %>
</article>

<% if any? %>
  <div class="post-list">
    <% editions.each do |day, posts| %>
      <section class="edition" aria-labelledby="edition-<%= day.iso8601 %>">
        <h2 class="edition__date" id="edition-<%= day.iso8601 %>">
          <time datetime="<%= day.iso8601 %>"><%= day.strftime("%A, %B %-d, %Y") %></time>
        </h2>

        <ol class="stories" role="list">
          <% posts.each do |post| %>
            <li class="story<%= ' story--lead' if lead?(post) %>">
              <h3 class="story__title">
                <a class="story__link" href="<%= post.relative_url %>"><%= post.data.title %></a>
              </h3>

              <% if post.data.summary %>
                <p class="story__summary"><%= post.data.summary %></p>
              <% end %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <% if more_url %>
      <p class="post-list__more">
        <a href="<%= more_url %>">All stories<span aria-hidden="true">&nbsp;&rarr;</span></a>
      </p>
    <% end %>
  </div>
<% else %>
  <p class="post-list__empty">No stories published yet.</p>
<% end %>

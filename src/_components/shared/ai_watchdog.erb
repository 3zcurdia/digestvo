<section
  class="mt-2 border-b border-border-color py-2 font-meta text-xs uppercase tracking-[0.08em] text-muted-color"
  aria-label="<%= t("ai_watchdog.brand") %>"
  data-pagefind-ignore
  data-watchdog
  data-api-latest="<%= latest_url %>"
  data-api-releases="<%= releases_url %>"
  data-since-today="<%= t("ai_watchdog.since.today") %>"
  data-since-one="<%= t("ai_watchdog.since.one") %>"
  data-since-other="<%= t("ai_watchdog.since.other") %>"
  data-average-one="<%= t("ai_watchdog.average.one") %>"
  data-average-other="<%= t("ai_watchdog.average.other") %>"
  data-link-title="<%= t("ai_watchdog.link_title") %>"
  data-radar-label="<%= t("ai_watchdog.radar.toggle") %>"
  data-radar-close="<%= t("ai_watchdog.radar.close") %>"
  data-radar-updated="<%= t("ai_watchdog.radar.updated") %>"
>
  <div class="flex items-center gap-x-2.5">
    <div class="flex min-w-0 flex-1 items-center gap-x-2.5 overflow-x-auto whitespace-nowrap">
      <span class="flex flex-none items-center gap-x-2">
        <a
          class="inline-flex items-center gap-2 text-heading-color no-underline focus-ring"
          href="<%= relative_url TagTaxonomy.path("AI Release") %>"
          title="<%= t("ai_watchdog.brand_link") %>"
          aria-label="<%= t("ai_watchdog.brand") %>: <%= t("ai_watchdog.brand_link") %>"
        >
          <span class="inline-flex size-[1.7em] flex-none items-center justify-center rounded-full border border-action-color text-action-color" aria-hidden="true">
            <svg class="size-[1em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
              <circle cx="12" cy="12" r="2.75" />
            </svg>
          </span>
          <span class="font-brand text-[0.95rem] leading-none font-normal normal-case tracking-[0.01em]"><%= t("ai_watchdog.brand") %></span>
        </a>
        <span class="inline-flex size-3.5 flex-none items-center justify-center [&[hidden]]:hidden" data-watchdog-live title="<%= t("ai_watchdog.live") %>" hidden>
          <span class="size-1.5 flex-none rounded-full bg-action-color" aria-hidden="true"></span>
          <span class="sr-only"><%= t("ai_watchdog.live") %></span>
        </span>
      </span>

      <span class="flex-none [&[hidden]]:hidden" data-watchdog-fallback>
        <%= t("ai_watchdog.fallback") %>
        <a class="link-plain text-body-color hover:underline focus-ring" href="https://models.dev" target="_blank" rel="noopener">models.dev</a>
      </span>

      <dl class="m-0 flex flex-none items-center gap-x-2.5 [&[hidden]]:hidden" data-watchdog-readout hidden>
        <div class="flex items-baseline gap-1.5">
          <dt><%= t("ai_watchdog.latest") %>:</dt>
          <dd class="m-0 flex items-baseline gap-1.5">
            <a class="link-plain text-body-color normal-case hover:underline focus-ring" data-watchdog-latest href="https://models.dev" target="_blank" rel="noopener">
              <span data-watchdog-latest-name></span>
              <svg class="ml-0.5 inline-block size-[0.8em] align-[-0.05em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M7 17 17 7" />
                <path d="M9 7h8v8" />
              </svg>
            </a>
            <span class="text-border-color" aria-hidden="true">·</span>
            <span data-watchdog-since></span>
          </dd>
        </div>
        <div class="flex items-baseline gap-1.5 [&[hidden]]:hidden" data-watchdog-average-row>
          <dt><%= t("ai_watchdog.average_label") %>:</dt>
          <dd class="m-0 font-bold text-body-color" data-watchdog-average></dd>
        </div>
      </dl>
    </div>

    <button
      type="button"
      class="link-plain focus-ring inline-flex flex-none cursor-pointer items-center gap-1 border-0 bg-transparent p-0 [font-family:inherit] [font-size:inherit] [line-height:inherit] [letter-spacing:inherit] [text-transform:inherit] [&[hidden]]:hidden"
      data-watchdog-radar-toggle
      aria-expanded="false"
      aria-controls="ai-watchdog-radar"
      hidden
    >
      <%= t("ai_watchdog.radar.toggle") %>
      <svg class="size-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
  </div>

  <div class="mt-2 border-t border-border-color pt-2 [&[hidden]]:hidden" id="ai-watchdog-radar" data-watchdog-radar hidden>
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <p class="section-label m-0 text-muted-color"><%= t("ai_watchdog.radar.title") %></p>
      <p class="m-0 text-[0.6875rem] text-muted-color" data-watchdog-radar-updated></p>
    </div>
    <ol class="mt-2 grid list-none gap-x-8 gap-y-1 p-0 normal-case sm:grid-cols-2" data-watchdog-radar-list></ol>
  </div>
</section>

<header>
  <div class="mx-auto max-w-[calc(var(--container-column)_+_2*clamp(1rem,4vw,3rem))] px-[clamp(1rem,4vw,3rem)] pt-7 text-center">
    <a class="inline-flex items-center gap-[0.3em] text-[clamp(1.9rem,1.4rem_+_2.5vw,2.75rem)] text-heading-color no-underline focus-visible:rounded-[2px] focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-[6px]" href="<%= relative_url '/' %>">
      <svg class="size-[1.1em] flex-none text-action-color [filter:drop-shadow(0_0_10px_light-dark(transparent,color-mix(in_srgb,var(--color-action-color)_40%,transparent)))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M3.5 8.5h13v6.25A4.25 4.25 0 0 1 12.25 19H7.75A4.25 4.25 0 0 1 3.5 14.75V8.5Z" />
        <path d="M16.5 10h1.25a2.75 2.75 0 0 1 0 5.5h-1.25" />
        <path d="M8 6.5c0-1 1-1.5 1-2.5S8 2.5 8 2.5" />
        <path d="M12 6.5c0-1 1-1.5 1-2.5S12 2.5 12 2.5" />
      </svg>
      <span class="font-brand text-[1em] font-normal leading-none tracking-[0.01em]"><%= @metadata.title %></span>
    </a>

    <div class="mt-[1.1rem] flex flex-wrap items-center justify-between gap-x-6 gap-y-[0.35rem] border-t border-b-[3px] border-border-color [border-bottom-style:double] py-[0.55rem] font-meta text-xs leading-[1.6] uppercase tracking-[0.08em] max-[480px]:justify-center">
      <p class="m-0 text-muted-color"><%= @metadata.tagline %></p>

      <nav aria-label="Main">
        <ul class="m-0 flex list-none items-center gap-5 p-0">
          <li>
            <a class="<%= nav_link_class '/posts' %>" href="<%= relative_url '/posts' %>"<%= ' aria-current="page"' if active?('/posts') %>>Stories</a>
          </li>
          <li>
            <a class="<%= nav_link_class '/about' %>" href="<%= relative_url '/about' %>"<%= ' aria-current="page"' if active?('/about') %>>About</a>
          </li>
          <li>
            <a class="inline-flex items-center p-[0.35rem] leading-[0] text-body-color no-underline hover:text-action-color focus-visible:rounded-[2px] focus-visible:text-action-color focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-[3px]" href="<%= relative_url '/feed.xml' %>" aria-label="RSS feed">
              <svg class="size-[1.5em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

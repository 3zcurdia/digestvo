---
layout: default
---

<%
  insights = Array(data.insights)
  facts = Shared::VideoMeta.new(data: data)
  videos = collections.videos.resources
  position = videos.index { |video| video.equal?(resource) }
  prev_video = position && position > 0 ? videos[position - 1] : nil
  next_video = position && videos[position + 1]
%>

<article class="article">
  <header class="article__header">
    <%# A video's kicker is its channel, which plays the same role the category
        bucket plays on a post: the one label that tells a reader whether this
        is the kind of thing they came for. %>
    <% if facts.channel %>
      <p class="kicker"><%= facts.channel %></p>
    <% end %>

    <h1 class="article__title"><%= data.title %></h1>

    <% if data.summary %>
      <p class="article__standfirst"><%= data.summary %></p>
    <% end %>

    <div class="article__meta">
      <% if data.watched %>
        <time class="article__date" datetime="<%= data.watched.to_s %>">
          Watched <%= data.watched.strftime("%A, %B %-d, %Y") %>
        </time>
      <% end %>
      <%= render facts %>
    </div>
  </header>

  <%# The thumbnail sits inside .column, so it is exactly as wide as the text
      measure and its edges still line up with the masthead and the footer.
      The 16:9 box is reserved in CSS so the page does not jump when it loads. %>
  <% if data.thumbnail %>
    <figure class="video-figure">
      <img
        class="video-figure__image"
        src="<%= relative_url data.thumbnail %>"
        alt="<%= data.title %>"
        fetchpriority="high"
      />
    </figure>
  <% end %>

  <%# Insights come from front matter as data, never as markup, so the same
      list can be re-rendered anywhere without re-parsing the body. %>
  <% if insights.any? %>
    <section class="article__body" aria-labelledby="insights-heading">
      <h2 class="section-label" id="insights-heading">Key insights</h2>
      <ul class="insights" role="list">
        <% insights.each do |insight| %>
          <li class="insights__item"><%= insight %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%# Only videos worth the reader's time are ever published, so this section is
      the argument for watching rather than a summary of what was said. %>
  <section class="article__body" aria-labelledby="take-heading">
    <h2 class="section-label" id="take-heading">Why it's worth your time</h2>
    <div class="prose prose--dropcap">
      <%= yield %>
    </div>
  </section>

  <%# Same read-on pager as a post, in index order. %>
  <% if prev_video || next_video %>
    <nav class="article__pager" aria-label="More videos">
      <% if prev_video %>
        <a class="article__pager-link" href="<%= prev_video.relative_url %>">
          <span class="article__pager-chevron" aria-hidden="true">&larr;</span>Previous
        </a>
      <% end %>
      <% if next_video %>
        <a class="article__pager-link" href="<%= next_video.relative_url %>">
          Next<span class="article__pager-chevron" aria-hidden="true">&rarr;</span>
        </a>
      <% end %>
    </nav>
  <% end %>
</article>
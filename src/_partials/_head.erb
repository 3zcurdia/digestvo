<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<% full_title = resource_title != "Index" ? "#{resource_title} | #{metadata.title}" : "#{metadata.title}: #{metadata.tagline}" %>
<title><%= full_title %></title>

<%# Share text prefers the story standfirst (summary), then the page
    description, then the site description — the same fallback chain a
    reader sees on the page. %>
<% page_description = strip_html(strip_newlines((data.summary || data.description || metadata.description).to_s)) %>
<% is_post = resource.respond_to?(:collection) && resource.collection&.label == "posts" %>
<% page_url = resource.respond_to?(:absolute_url) ? resource.absolute_url : absolute_url(resource.relative_url) %>
<% og_image = absolute_url("/og-image.png") %>

<meta name="description" content="<%= page_description %>" />
<link rel="canonical" href="<%= page_url %>" />

<%# Icons: SVG for modern browsers, ICO fallback, PNG for iOS home screens. %>
<link rel="icon" href="<%= relative_url "/favicon.ico" %>" sizes="32x32" />
<link rel="icon" href="<%= relative_url "/icon.svg" %>" type="image/svg+xml" />
<link rel="apple-touch-icon" href="<%= relative_url "/apple-touch-icon.png" %>" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f1e8" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0b0a" />

<%# Open Graph + X/Twitter cards, so every share carries the story summary
    and the digestvo mark. %>
<meta property="og:type" content="<%= is_post ? "article" : "website" %>" />
<meta property="og:site_name" content="<%= metadata.title %>" />
<meta property="og:title" content="<%= full_title %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:url" content="<%= page_url %>" />
<meta property="og:image" content="<%= og_image %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="<%= metadata.title %> — <%= metadata.tagline %>" />
<meta property="og:locale" content="es_ES" />
<% if is_post %>
<meta property="article:published_time" content="<%= resource.date.iso8601 %>" />
<% end %>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= full_title %>" />
<meta name="twitter:description" content="<%= page_description %>" />
<meta name="twitter:image" content="<%= og_image %>" />

<%# Runs before the stylesheet so an edition chosen on an earlier visit is
    painted with the page — no flash of the device's theme first. Without a
    stored choice (or without JavaScript) the `color-scheme` default in the
    CSS leaves the device in charge. %>
<script>
  try {
    var edition = localStorage.getItem("edition");
    if (edition === "light" || edition === "dark") {
      document.documentElement.dataset.theme = edition;
    }
  } catch (error) {}
</script>

<link rel="stylesheet" href="<%= asset_path :css %>" />
<%= feed_meta %>
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>

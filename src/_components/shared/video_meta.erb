<ul class="video-meta" role="list">
  <% if duration %>
    <li class="video-meta__fact"><%= duration %></li>
  <% end %>

  <% if channel %>
    <li class="video-meta__fact">
      <% if channel_url %>
        <a class="video-meta__link" href="<%= channel_url %>"><%= channel %></a>
      <% else %>
        <%= channel %>
      <% end %>
    </li>
  <% end %>

  <% if video_url %>
    <li>
      <a class="video-meta__link" href="<%= video_url %>">
        <%# The play-in-a-box mark YouTube uses for itself. Drawn here rather
            than inlined per post, the same way SourceLinks owns the HN and
            Lobsters marks, so no video page ever carries markup. %>
        <svg class="video-meta__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z" />
        </svg>
        Watch on YouTube<span class="sr-only">: <%= @data["title"] %></span>
      </a>
    </li>
  <% end %>
</ul>
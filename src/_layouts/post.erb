---
layout: default
---

<%
  tags = Array(data.tags)
  sources = Shared::SourceLinks.new(data: data)
  # A story from both sites opens each take with a bold "On Hacker News." /
  # "On Lobsters." lead-in, and a drop cap would split that label in two.
  dropcap = sources.discussions.size < 2
  posts = collections.posts.resources
  position = posts.index { |post| post.equal?(resource) }
  prev_post = position && position > 0 ? posts[position - 1] : nil
  next_post = position && posts[position + 1]
  related = TagTaxonomy.related_posts(posts, resource, limit: 4)
%>

<article>
  <header class="mb-8 border-b border-border-color pb-6">
    <% if tags.any? %>
      <p class="mb-3 font-meta text-xs leading-[1.6] font-bold uppercase tracking-[0.1em] text-muted-color">
        <% tags.each_with_index do |tag, index| %>
          <%= " · " if index.positive? %><a class="text-muted-color no-underline underline-offset-[0.18em] hover:text-action-color focus-visible:rounded-[2px] focus-visible:text-action-color focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-[3px]" href="<%= TagTaxonomy.path(tag) %>"><%= tag %></a>
        <% end %>
      </p>
    <% end %>

    <h1 class="m-0 font-serif text-[clamp(2rem,1.35rem_+_2.6vw,3rem)] leading-[1.08] font-bold tracking-[-0.02em] text-balance text-heading-color"><%= data.title %></h1>

    <% if data.summary %>
      <p class="mt-4 mb-0 text-[1.3rem] leading-[1.45] italic text-body-color"><%= data.summary %></p>
    <% end %>

    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
      <time class="font-meta text-sm leading-[1.6] text-muted-color" datetime="<%= resource.date.strftime('%Y-%m-%d') %>">
        <%= resource.date.strftime("%A, %B %-d, %Y") %>
      </time>
      <%= render sources %>
    </div>
  </header>

  <%# The body is always the digest of the comment threads, never a second
      summary — label it so a reader knows which voice they are reading. %>
  <section aria-labelledby="discussion-heading">
    <h2 class="mb-4 font-meta text-xs leading-[1.6] font-bold uppercase tracking-[0.1em] text-muted-color" id="discussion-heading">The discussion</h2>
    <div class="prose<%= ' prose-dropcap' if dropcap %>">
      <%= yield %>
    </div>
  </section>

  <%# Read-on pager, in index order: prev_post is the story above this one on
      the front page, next_post the one below. Each row only when it exists;
      the whole block drops out on a day with a single story. %>
  <% if prev_post || next_post %>
    <nav class="mt-12 flex items-center justify-center gap-10 border-t border-border-color pt-4" aria-label="More stories">
      <% if prev_post %>
        <a class="group inline-flex items-center gap-[0.5em] font-meta text-sm leading-[1.6] font-bold uppercase tracking-[0.1em] text-heading-color no-underline hover:text-action-color focus-visible:rounded-[2px] focus-visible:text-action-color focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-4" href="<%= prev_post.relative_url %>">
          <span class="inline-block text-[1.25em] leading-none font-normal group-hover:-translate-x-[0.2em] group-focus-visible:-translate-x-[0.2em]" aria-hidden="true">&larr;</span>Previous
        </a>
      <% end %>
      <% if next_post %>
        <a class="group inline-flex items-center gap-[0.5em] font-meta text-sm leading-[1.6] font-bold uppercase tracking-[0.1em] text-heading-color no-underline hover:text-action-color focus-visible:rounded-[2px] focus-visible:text-action-color focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-4" href="<%= next_post.relative_url %>">
          Next<span class="inline-block text-[1.25em] leading-none font-normal group-hover:translate-x-[0.2em] group-focus-visible:translate-x-[0.2em]" aria-hidden="true">&rarr;</span>
        </a>
      <% end %>
    </nav>
  <% end %>

  <%# Same-topic stories, newest first, excluding this one. Drops out entirely
      when the tag is unique to this post — a lone story is not a thread. %>
  <% if related.any? && tags.any? %>
    <section class="mt-12" aria-labelledby="related-heading">
      <h2 class="mb-4 font-meta text-xs leading-[1.6] font-bold uppercase tracking-[0.1em] text-muted-color" id="related-heading">More in <%= tags.first %></h2>
      <ol class="m-0 list-none divide-y divide-border-color p-0" role="list">
        <% related.each do |post| %>
          <li class="group relative py-4 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-action-color has-[a:focus-visible]:outline-offset-4">
            <h3 class="m-0 font-serif text-[1.25rem] leading-[1.2] font-[650] tracking-[-0.005em] text-balance text-heading-color">
              <a class="text-heading-color no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-none group-hover:text-action-color" href="<%= post.relative_url %>"><%= post.data.title %></a>
            </h3>
            <time class="mt-1 block font-meta text-sm leading-[1.6] text-muted-color" datetime="<%= post.date.strftime('%Y-%m-%d') %>"><%= post.date.strftime("%B %-d, %Y") %></time>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
</article>

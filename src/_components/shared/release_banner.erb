<div class="w-full">
  <div class="mx-auto max-w-[calc(var(--container-column)_+_2*clamp(1rem,4vw,3rem))] px-[clamp(1rem,4vw,3rem)] mt-2 font-meta text-xs text-muted-color uppercase"
     data-release-banner
     data-last-release="<%= last_release.iso8601 %>"
     data-since-one="<%= t("release_banner.since.one") %>"
     data-since-other="<%= t("release_banner.since.other") %>">
    <a class="font-bold text-muted-color no-underline underline-offset-[0.18em] hover:text-action-color focus-visible:rounded-[2px] focus-visible:text-action-color focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-[3px]" href="<%= relative_url TagTaxonomy.path("AI Release") %>"><%= t("release_banner.label") %></a>: <a class="font-bold text-body-color no-underline underline-offset-[0.18em] hover:text-action-color focus-visible:rounded-[2px] focus-visible:text-action-color focus-visible:outline-2 focus-visible:outline-action-color focus-visible:outline-offset-[3px]" href="<%= latest_post.relative_url %>" title="<%= latest_post.data.title %>"><span data-days-since><%= t("release_banner.since", count: days_since) %></span></a><% if formatted_avg_number %>, <strong class="font-bold text-body-color"><%= t("release_banner.average", avg: formatted_avg_number) %></strong><% end %>
    <time class="sr-only" datetime="<%= last_release.iso8601 %>"><%= l(last_release, format: :short) %></time>
  </div>
</div>

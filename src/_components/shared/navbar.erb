<header class="masthead">
  <div class="masthead__inner">
    <a class="brand" href="<%= relative_url '/' %>">
      <svg class="brand__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M3.5 8.5h13v6.25A4.25 4.25 0 0 1 12.25 19H7.75A4.25 4.25 0 0 1 3.5 14.75V8.5Z" />
        <path d="M16.5 10h1.25a2.75 2.75 0 0 1 0 5.5h-1.25" />
        <path d="M8 6.5c0-1 1-1.5 1-2.5S8 2.5 8 2.5" />
        <path d="M12 6.5c0-1 1-1.5 1-2.5S12 2.5 12 2.5" />
      </svg>
      <span class="brand__name"><%= @metadata.title %></span>
    </a>

    <div class="masthead__strip">
      <p class="masthead__tagline"><%= @metadata.tagline %></p>

      <nav class="site-nav" aria-label="Main">
        <ul class="site-nav__list">
          <li>
            <a class="<%= nav_link_class '/posts' %>" href="<%= relative_url '/posts' %>"<%= ' aria-current="page"' if active?('/posts') %>>Stories</a>
          </li>
          <li>
            <a class="<%= nav_link_class '/about' %>" href="<%= relative_url '/about' %>"<%= ' aria-current="page"' if active?('/about') %>>About</a>
          </li>
          <li>
            <a class="site-nav__icon-link" href="<%= relative_url '/feed.xml' %>" aria-label="RSS feed">
              <svg class="site-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
